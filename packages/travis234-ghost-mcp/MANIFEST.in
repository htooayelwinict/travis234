include LICENSE
include README.md
include THIRD_PARTY_NOTICES.md
include UPSTREAM.json
include pyproject.toml
include setup.py
include extensions/ghost_mcp.py
recursive-include licenses *
recursive-include travis234_ghost_mcp *.py *.md *.json ghost-vision requirements.txt .gitkeep
include vendor/ghost-os/Package.swift
include vendor/ghost-os/Package.resolved
recursive-include vendor/ghost-os/Sources *.swift
recursive-include vendor/ghost-os/Tests *.swift
recursive-include tests *.py
prune vendor/ghost-os/.build
prune vendor/ghost-os/.git
global-exclude *.py[cod]
global-exclude __pycache__
global-exclude .DS_Store
global-exclude *.log
global-exclude *.tar.gz
